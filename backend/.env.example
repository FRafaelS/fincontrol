NODE_ENV=production
PORT=3001

# Use preferencialmente DATABASE_URL na hospedagem.
DATABASE_URL=postgres://usuario:senha@host:5432/fincontrol
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Gere um valor longo e único para produção.
JWT_SECRET=troque_por_um_segredo_com_32_ou_mais_caracteres

# Informe o domínio público do frontend. Separe múltiplas origens por vírgula.
CORS_ORIGINS=https://seu-frontend.vercel.app

# Admin inicial criado automaticamente.
ADMIN_NAME=Raphael Administrador
ADMIN_EMAIL=ps.raphael@hotmail.com
ADMIN_INITIAL_PASSWORD=admin123
ADMIN_FORCE_PASSWORD_CHANGE=true

# Manutenção sensível. Mantenha desligado e habilite só quando necessário.
ENABLE_SETUP_ROUTE=false
ENABLE_ADMIN_SQL=false
ENABLE_ADMIN_SQL_WRITE=false
ADMIN_SQL_MAX_ROWS=1000
ADMIN_SQL_TIMEOUT_MS=15000
